{
  "jsonid": "input_profile",
  "controller_type": "pixelvr_right",
  "device_class": "controller",
  "resource_root": "pixelvr",
  "input_bindingui_mode": "controller_handed",
  "input_bindingui_right": {
    "image": "{pixelvr}/icons/oculus_touch_right.svg"
  },
  "input_bindings": {
    "/input/a/click": {
      "type": "button",
      "parameters": { "click": true }
    },
    "/input/b/click": {
      "type": "button",
      "parameters": { "click": true }
    },
    "/input/trigger/click": {
      "type": "button",
      "parameters": { "click": true }
    },
    "/input/trigger/value": {
      "type": "trigger",
      "parameters": { "value": true }
    },
    "/input/grip/click": {
      "type": "button",
      "parameters": { "click": true }
    },
    "/input/grip/value": {
      "type": "trigger",
      "parameters": { "value": true }
    },
    "/input/system/click": {
      "type": "button",
      "parameters": { "click": true }
    },
    "/input/joystick/x": {
      "type": "joystick",
      "parameters": { "x": true }
    },
    "/input/joystick/y": {
      "type": "joystick",
      "parameters": { "y": true }
    },
    "/input/joystick/click": {
      "type": "button",
      "parameters": { "click": true }
    }
  }
}
