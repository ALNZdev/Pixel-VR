                                        <Button x:Name="rightSystemButton" Content="System" Width="60" Height="26" Margin="3" FontSize="11" FontWeight="SemiBold" Background="#12151F" Foreground="#9EA3B8" BorderBrush="#2A2E42" BorderThickness="1" materialDesign:ButtonAssist.CornerRadius="6" Style="{StaticResource MaterialDesignFlatButton}" PreviewMouseLeftButtonDown="rightSystemButton_Down" PreviewMouseLeftButtonUp="rightSystemButton_Up" MouseLeave="rightSystemButton_Up"/>
                                        <Button x:Name="rightTriggerButton" Content="Trigger" Width="60" Height="26" Margin="3" FontSize="11" FontWeight="SemiBold" Background="#12151F" Foreground="#9EA3B8" BorderBrush="#2A2E42" BorderThickness="1" materialDesign:ButtonAssist.CornerRadius="6" Style="{StaticResource MaterialDesignFlatButton}" PreviewMouseLeftButtonDown="rightTriggerButton_Down" PreviewMouseLeftButtonUp="rightTriggerButton_Up" MouseLeave="rightTriggerButton_Up"/>
                                        <Button x:Name="rightGripButton" Content="Grip" Width="52" Height="26" Margin="3" FontSize="11" FontWeight="SemiBold" Background="#12151F" Foreground="#9EA3B8" BorderBrush="#2A2E42" BorderThickness="1" materialDesign:ButtonAssist.CornerRadius="6" Style="{StaticResource MaterialDesignFlatButton}" PreviewMouseLeftButtonDown="rightGripButton_Down" PreviewMouseLeftButtonUp="rightGripButton_Up" MouseLeave="rightGripButton_Up"/>
                                    </WrapPanel>

                                    <StackPanel Grid.Row="2">
                                        <StackPanel Orientation="Horizontal" Margin="0,4" HorizontalAlignment="Center">
                                            <TextBlock Text="X" Width="52" FontFamily="Segoe UI" FontSize="12" Foreground="#9EA3B8" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,8,0"/>
                                            <Slider x:Name="rightXSlider" Width="200" Minimum="-2" Maximum="2" VerticalAlignment="Center" ValueChanged="rightXSlider_ValueChanged"/>
                                            <Label x:Name="rightXLabel" Content="0" Width="44" FontFamily="Consolas" FontSize="12" Foreground="#E8EAF6" Padding="4,0,0,0" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4" HorizontalAlignment="Center">
                                            <TextBlock Text="Y" Width="52" FontFamily="Segoe UI" FontSize="12" Foreground="#9EA3B8" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,8,0"/>
                                            <Slider x:Name="rightYSlider" Width="200" Minimum="-2" Maximum="2" VerticalAlignment="Center" ValueChanged="rightYSlider_ValueChanged"/>
                                            <Label x:Name="rightYLabel" Content="0" Width="44" FontFamily="Consolas" FontSize="12" Foreground="#E8EAF6" Padding="4,0,0,0" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4" HorizontalAlignment="Center">
                                            <TextBlock Text="Z" Width="52" FontFamily="Segoe UI" FontSize="12" Foreground="#9EA3B8" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,8,0"/>
                                            <Slider x:Name="rightZSlider" Width="200" Minimum="-2" Maximum="2" VerticalAlignment="Center" ValueChanged="rightZSlider_ValueChanged"/>
                                            <Label x:Name="rightZLabel" Content="0" Width="44" FontFamily="Consolas" FontSize="12" Foreground="#E8EAF6" Padding="4,0,0,0" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4" HorizontalAlignment="Center">
                                            <TextBlock Text="Pitch" Width="52" FontFamily="Segoe UI" FontSize="12" Foreground="#9EA3B8" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,8,0"/>
                                            <Slider x:Name="rightPitchSlider" Width="200" Minimum="-180" Maximum="180" VerticalAlignment="Center" ValueChanged="rightPitchSlider_ValueChanged"/>
                                            <Label x:Name="rightPitchLabel" Content="0" Width="44" FontFamily="Consolas" FontSize="12" Foreground="#E8EAF6" Padding="4,0,0,0" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4" HorizontalAlignment="Center">
                                            <TextBlock Text="Yaw" Width="52" FontFamily="Segoe UI" FontSize="12" Foreground="#9EA3B8" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,8,0"/>
                                            <Slider x:Name="rightYawSlider" Width="200" Minimum="-180" Maximum="180" VerticalAlignment="Center" ValueChanged="rightYawSlider_ValueChanged"/>
                                            <Label x:Name="rightYawLabel" Content="0" Width="44" FontFamily="Consolas" FontSize="12" Foreground="#E8EAF6" Padding="4,0,0,0" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4" HorizontalAlignment="Center">
                                            <TextBlock Text="Roll" Width="52" FontFamily="Segoe UI" FontSize="12" Foreground="#9EA3B8" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,8,0"/>
                                            <Slider x:Name="rightRollSlider" Width="200" Minimum="-180" Maximum="180" VerticalAlignment="Center" ValueChanged="rightRollSlider_ValueChanged"/>
                                            <Label x:Name="rightRollLabel" Content="0" Width="44" FontFamily="Consolas" FontSize="12" Foreground="#E8EAF6" Padding="4,0,0,0" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4" HorizontalAlignment="Center">
                                            <TextBlock Text="Stick X" Width="52" FontFamily="Segoe UI" FontSize="12" Foreground="#9EA3B8" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,8,0"/>
                                            <Slider x:Name="rightStickX" Width="200" Minimum="-1" Maximum="1" VerticalAlignment="Center" ValueChanged="rightStickX_ValueChanged"/>
                                            <Label x:Name="rightStickXLabel" Content="0" Width="44" FontFamily="Consolas" FontSize="12" Foreground="#E8EAF6" Padding="4,0,0,0" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4" HorizontalAlignment="Center">
                                            <TextBlock Text="Stick Y" Width="52" FontFamily="Segoe UI" FontSize="12" Foreground="#9EA3B8" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,8,0"/>
                                            <Slider x:Name="rightStickY" Width="200" Minimum="-1" Maximum="1" VerticalAlignment="Center" ValueChanged="rightStickY_ValueChanged"/>
                                            <Label x:Name="rightStickYLabel" Content="0" Width="44" FontFamily="Consolas" FontSize="12" Foreground="#E8EAF6" Padding="4,0,0,0" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- PESTAÑA CONFIG -->
            <TabItem x:Name="tabConfig" Style="{StaticResource VerticalNavTabItem}">
                <TabItem.Header>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="TuneVariant"
                                                Width="28" Height="28"
                                                Foreground="#7C6AF7"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,6"/>
                        <TextBlock Text="Config"
                                   FontFamily="Segoe UI" FontSize="10"
                                   Foreground="#9EA3B8"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid x:Name="contentConfig" Background="#0A0C12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar -->
                    <Border Grid.Row="0"
                            Background="#0E1120"
                            BorderBrush="#1E2235" BorderThickness="0,0,0,1"
                            Padding="14,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="btnLoadSettings"
                                    Height="32" Padding="16,0" Margin="0,0,6,0"
                                    FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                    Background="#121822" Foreground="#9EA3B8"
                                    BorderBrush="#2A2E42" BorderThickness="1"
                                    materialDesign:ButtonAssist.CornerRadius="7"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Click="btnLoadSettings_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderOpen" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Cargar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnSaveSettings"
                                    Height="32" Padding="16,0" Margin="0,0,6,0"
                                    FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                    Background="#1522C993" Foreground="#22C993"
                                    BorderBrush="#3022C993" BorderThickness="1"
                                    materialDesign:ButtonAssist.CornerRadius="7"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Click="btnSaveSettings_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSave" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Guardar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnResetDefaults"
                                    Height="32" Padding="16,0"
                                    FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                    Background="#12151F" Foreground="#9EA3B8"
                                    BorderBrush="#2A2E42" BorderThickness="1"
                                    materialDesign:ButtonAssist.CornerRadius="7"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Click="btnResetDefaults_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Predeterminados" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Settings Panel -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="Transparent" Margin="12">
                        <StackPanel>

                            <!-- Display Section -->
                            <Border Background="#0E1120" BorderBrush="#1E2235" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Rectangle Height="1" Fill="#2A2E42" Width="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="PANTALLA" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#7C6AF7" VerticalAlignment="Center"/>
                                        <Rectangle Height="1" Fill="#2A2E42" Width="16" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,0,12">
                                            <TextBlock Text="Frecuencia Display (Hz)" FontFamily="Segoe UI" FontSize="11" Foreground="#C8CEDD" Margin="0,0,0,4"/>
                                            <Slider x:Name="sliderDisplayFreq" Minimum="30" Maximum="144" Value="90" VerticalAlignment="Center" ValueChanged="sliderDisplayFreq_ValueChanged"/>
                                            <TextBlock x:Name="lblDisplayFreq" Text="90" FontFamily="Consolas" FontSize="10" Foreground="#7C6AF7"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="12,0,0,12">
                                            <TextBlock Text="IPD Metros" FontFamily="Segoe UI" FontSize="11" Foreground="#C8CEDD" Margin="0,0,0,4"/>
                                            <Slider x:Name="sliderIpd" Minimum="0.050" Maximum="0.075" Value="0.064" SmallChange="0.001" LargeChange="0.005" VerticalAlignment="Center" ValueChanged="sliderIpd_ValueChanged"/>
                                            <TextBlock x:Name="lblIpd" Text="0.064" FontFamily="Consolas" FontSize="10" Foreground="#7C6AF7"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="12,0,0,12">
                                            <TextBlock Text="Ancho Render" FontFamily="Segoe UI" FontSize="11" Foreground="#C8CEDD" Margin="0,0,0,4"/>
                                            <TextBox x:Name="txtRenderWidth" Text="1920" FontFamily="Consolas" FontSize="10" Background="#12151F" Foreground="#E8EAF6" BorderBrush="#1E2235" Padding="8"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Margin="12,0,0,12">
                                            <TextBlock Text="Alto Render" FontFamily="Segoe UI" FontSize="11" Foreground="#C8CEDD" Margin="0,0,0,4"/>
                                            <TextBox x:Name="txtRenderHeight" Text="1080" FontFamily="Consolas" FontSize="10" Background="#12151F" Foreground="#E8EAF6" BorderBrush="#1E2235" Padding="8"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,0,0">
                                            <TextBlock Text="Pantalla SteamVR" FontFamily="Segoe UI" FontSize="11" Foreground="#C8CEDD" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="hmdScreenComboBox" Height="34" Style="{StaticResource DarkComboBox}" SelectionChanged="hmdScreenComboBox_SelectionChanged"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="Modo de Pantalla" FontFamily="Segoe UI" FontSize="11" Foreground="#C8CEDD" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="hmsScreenModeComboBox" Height="34" Style="{StaticResource DarkComboBox}" SelectionChanged="hmsScreenModeComboBox_SelectionChanged">
                                                <ComboBoxItem Content="Modo Ventana"/>
                                                <ComboBoxItem Content="Modo Directo"/>
                                                <ComboBoxItem Content="Modo Debug"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- FOV Section -->
                            <Border Background="#0E1120" BorderBrush="#1E2235" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Rectangle Height="1" Fill="#2A2E42" Width="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="CAMPO DE VISIÓN (FOV)" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#7C6AF7" VerticalAlignment="Center"/>
                                        <Rectangle Height="1" Fill="#2A2E42" Width="16" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,0,12">
                                            <TextBlock Text="FOV Izquierda (°)" FontFamily="Segoe UI" FontSize="11" Foreground="#C8CEDD" Margin="0,0,0,4"/>
                                            <Slider x:Name="sliderFovLeft" Minimum="30" Maximum="200" Value="50" VerticalAlignment="Center" ValueChanged="sliderFovLeft_ValueChanged"/>
                                            <TextBlock x:Name="lblFovLeft" Text="50" FontFamily="Consolas" FontSize="10" Foreground="#7C6AF7"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="12,0,0,12">
                                            <TextBlock Text="FOV Derecha (°)" FontFamily="Segoe UI" FontSize="11" Foreground="#C8CEDD" Margin="0,0,0,4"/>
                                            <Slider x:Name="sliderFovRight" Minimum="30" Maximum="200" Value="50" VerticalAlignment="Center" ValueChanged="sliderFovRight_ValueChanged"/>
                                            <TextBlock x:Name="lblFovRight" Text="50" FontFamily="Consolas" FontSize="10" Foreground="#7C6AF7"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="12,0,0,12">
                                            <TextBlock Text="FOV Arriba (°)" FontFamily="Segoe UI" FontSize="11" Foreground="#C8CEDD" Margin="0,0,0,4"/>
                                            <Slider x:Name="sliderFovTop" Minimum="30" Maximum="200" Value="50" VerticalAlignment="Center" ValueChanged="sliderFovTop_ValueChanged"/>
                                            <TextBlock x:Name="lblFovTop" Text="50" FontFamily="Consolas" FontSize="10" Foreground="#7C6AF7"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Margin="12,0,0,12">
                                            <TextBlock Text="FOV Abajo (°)" FontFamily="Segoe UI" FontSize="11" Foreground="#C8CEDD" Margin="0,0,0,4"/>
                                            <Slider x:Name="sliderFovBottom" Minimum="30" Maximum="200" Value="50" VerticalAlignment="Center" ValueChanged="sliderFovBottom_ValueChanged"/>
                                            <TextBlock x:Name="lblFovBottom" Text="50" FontFamily="Consolas" FontSize="10" Foreground="#7C6AF7"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Tracking Section -->
                            <Border Background="#0E1120" BorderBrush="#1E2235" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Rectangle Height="1" Fill="#2A2E42" Width="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="TRACKING" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#7C6AF7" VerticalAlignment="Center"/>
                                        <Rectangle Height="1" Fill="#2A2E42" Width="16" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,0,12">
                                            <TextBlock Text="Escala de Tracking" FontFamily="Segoe UI" FontSize="11" Foreground="#C8CEDD" Margin="0,0,0,4"/>
                                            <Slider x:Name="sliderTrackingScale" Minimum="0.1" Maximum="10.0" Value="1.0" SmallChange="0.1" LargeChange="0.5" VerticalAlignment="Center" ValueChanged="sliderTrackingScale_ValueChanged"/>
                                            <TextBlock x:Name="lblTrackingScale" Text="1.0" FontFamily="Consolas" FontSize="10" Foreground="#7C6AF7"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="12,0,0,12">
                                            <TextBlock Text="PSM Timeout (ms)" FontFamily="Segoe UI" FontSize="11" Foreground="#C8CEDD" Margin="0,0,0,4"/>
                                            <TextBox x:Name="txtPsmTimeout" Text="5000" FontFamily="Consolas" FontSize="10" Background="#12151F" Foreground="#E8EAF6" BorderBrush="#1E2235" Padding="8"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="12,0,0,12">
                                            <TextBlock Text="PSM Reintentos" FontFamily="Segoe UI" FontSize="11" Foreground="#C8CEDD" Margin="0,0,0,4"/>
                                            <TextBox x:Name="txtPsmRetries" Text="5" FontFamily="Consolas" FontSize="10" Background="#12151F" Foreground="#E8EAF6" BorderBrush="#1E2235" Padding="8"/>
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox x:Name="chkEnablePosTracking" Content="Habilitar Tracking de Posición" Foreground="#C8CEDD" Margin="0,8,0,0" IsChecked="True"/>
                                    <CheckBox x:Name="chkEnableRotTracking" Content="Habilitar Tracking de Rotación" Foreground="#C8CEDD" Margin="0,4,0,0" IsChecked="True"/>
                                    <CheckBox x:Name="chkEnablePSMTracking" Content="Habilitar PSM Tracking" Foreground="#C8CEDD" Margin="0,4,0,0" IsChecked="True"/>
                                </StackPanel>
                            </Border>

                            <!-- Controllers Section -->
                            <Border Background="#0E1120" BorderBrush="#1E2235" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Rectangle Height="1" Fill="#2A2E42" Width="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="CONTROLES" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#7C6AF7" VerticalAlignment="Center"/>
                                        <Rectangle Height="1" Fill="#2A2E42" Width="16" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,0,12">
                                            <TextBlock Text="Amplitud Háptica Izquierda" FontFamily="Segoe UI" FontSize="11" Foreground="#C8CEDD" Margin="0,0,0,4"/>
                                            <Slider x:Name="sliderLeftHaptic" Minimum="0" Maximum="1.0" Value="1.0" SmallChange="0.1" LargeChange="0.1" VerticalAlignment="Center" ValueChanged="sliderLeftHaptic_ValueChanged"/>
                                            <TextBlock x:Name="lblLeftHaptic" Text="1.0" FontFamily="Consolas" FontSize="10" Foreground="#7C6AF7"/>
                                            <CheckBox x:Name="chkLeftHaptics" Content="Habilitar Háptica Izquierda" Foreground="#C8CEDD" Margin="0,4,0,0" IsChecked="True"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="12,0,0,12">
                                            <TextBlock Text="Amplitud Háptica Derecha" FontFamily="Segoe UI" FontSize="11" Foreground="#C8CEDD" Margin="0,0,0,4"/>
                                            <Slider x:Name="sliderRightHaptic" Minimum="0" Maximum="1.0" Value="1.0" SmallChange="0.1" LargeChange="0.1" VerticalAlignment="Center" ValueChanged="sliderRightHaptic_ValueChanged"/>
                                            <TextBlock x:Name="lblRightHaptic" Text="1.0" FontFamily="Consolas" FontSize="10" Foreground="#7C6AF7"/>
                                            <CheckBox x:Name="chkRightHaptics" Content="Habilitar Háptica Derecha" Foreground="#C8CEDD" Margin="0,4,0,0" IsChecked="True"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Advanced Section -->
                            <Border Background="#0E1120" BorderBrush="#1E2235" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Rectangle Height="1" Fill="#2A2E42" Width="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="AVANZADO" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#7C6AF7" VerticalAlignment="Center"/>
                                        <Rectangle Height="1" Fill="#2A2E42" Width="16" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>

                                    <CheckBox x:Name="chkDebugMode" Content="Modo Debug" Foreground="#C8CEDD" Margin="0,4,0,0"/>
                                    <CheckBox x:Name="chkDirectMode" Content="Modo Directo" Foreground="#C8CEDD" Margin="0,4,0,0"/>
                                    <CheckBox x:Name="chkVerboseLogging" Content="Logging Detallado" Foreground="#C8CEDD" Margin="0,4,0,0"/>
                                    <CheckBox x:Name="chkAsyncReprojection" Content="Async Reprojection" Foreground="#C8CEDD" Margin="0,4,0,0" IsChecked="True"/>
                                    <CheckBox x:Name="chkVsyncEnabled" Content="VSync Habilitado" Foreground="#C8CEDD" Margin="0,4,0,0" IsChecked="True"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#0E1120"
                                BorderBrush="#1E2235"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,0,0,14">

                                <StackPanel>
                                    <TextBlock Text="Display Mode"
                                        FontFamily="Segoe UI"
                                        FontSize="11"
                                        Foreground="#9EA3B8"
                                        Margin="0,0,0,10"/>

                                    <RadioButton x:Name="radioPcMonitor"
                                        GroupName="DisplayMode"
                                        Content="PC Monitor"
                                        Foreground="#E8EAF6"
                                        IsChecked="True"
                                        Checked="radioPcMonitor_Checked"
                                        Margin="0,0,0,8"/>

                                    <RadioButton x:Name="radioAndroidUsb"
                                        GroupName="DisplayMode"
                                        Content="Android Phone (USB)"
                                        Foreground="#E8EAF6"
                                        Checked="radioAndroidUsb_Checked"
                                        Margin="0,0,0,12"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="ADB Path"
                                                FontFamily="Segoe UI"
                                                FontSize="10"
                                                Foreground="#9EA3B8"
                                                Margin="0,0,0,4"/>
                                            <TextBox x:Name="txtAdbPath"
                                                Height="32"
                                                Background="#12151F"
                                                Foreground="#E8EAF6"
                                                BorderBrush="#2A2E42"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Android Serial"
                                                FontFamily="Segoe UI"
                                                FontSize="10"
                                                Foreground="#9EA3B8"
                                                Margin="0,0,0,4"/>
                                            <TextBox x:Name="txtAndroidSerial"
                                                Height="32"
                                                Background="#12151F"
                                                Foreground="#E8EAF6"
                                                BorderBrush="#2A2E42"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Streaming Port"
                                                FontFamily="Segoe UI"
                                                FontSize="10"
                                                Foreground="#9EA3B8"
                                                Margin="0,0,0,4"/>
                                            <TextBox x:Name="txtStreamingPort"
                                                Height="32"
                                                Text="9944"
                                                Background="#12151F"
                                                Foreground="#E8EAF6"
                                                BorderBrush="#2A2E42"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Bitrate (kbps)"
                                                FontFamily="Segoe UI"
                                                FontSize="10"
                                                Foreground="#9EA3B8"
                                                Margin="0,0,0,4"/>
                                            <TextBox x:Name="txtStreamingBitrate"
                                                Height="32"
                                                Text="15000"
                                                Background="#12151F"
                                                Foreground="#E8EAF6"
                                                BorderBrush="#2A2E42"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Resolution Width"
                                                FontFamily="Segoe UI"
                                                FontSize="10"
                                                Foreground="#9EA3B8"
                                                Margin="0,0,0,4"/>
                                            <TextBox x:Name="txtStreamWidth"
                                                Height="32"
                                                Text="1920"
                                                Background="#12151F"
                                                Foreground="#E8EAF6"
                                                BorderBrush="#2A2E42"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Resolution Height"
                                                FontFamily="Segoe UI"
                                                FontSize="10"
                                                Foreground="#9EA3B8"
                                                Margin="0,0,0,4"/>
                                            <TextBox x:Name="txtStreamHeight"
                                                Height="32"
                                                Text="1080"
                                                Background="#12151F"
                                                Foreground="#E8EAF6"
                                                BorderBrush="#2A2E42"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Prueba inicial de baja latencia: 1920 × 852 y 60 FPS."
                                        FontFamily="Segoe UI"
                                        FontSize="10"
                                        Foreground="#7F879F"
                                        Margin="0,8,0,0"/>

                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="Streaming FPS (prueba 60 para reducir latencia)"
                                            FontFamily="Segoe UI"
                                            FontSize="10"
                                            Foreground="#9EA3B8"
                                            Margin="0,0,0,4"/>
                                        <TextBox x:Name="txtStreamFramerate"
                                            Height="32"
                                            Text="60"
                                            Background="#12151F"
                                            Foreground="#E8EAF6"
                                            BorderBrush="#2A2E42"/>
                                        <CheckBox x:Name="chkStreamFollowsDisplayFrequency"
                                            Content="Igualar FPS de transmisión con Hz del HMD"
                                            Margin="0,6,0,0"
                                            Foreground="#C8CEDD"
                                            Checked="chkStreamFollowsDisplayFrequency_CheckedChanged"
                                            Unchecked="chkStreamFollowsDisplayFrequency_CheckedChanged"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="Codec"
                                            FontFamily="Segoe UI"
                                            FontSize="10"
                                            Foreground="#9EA3B8"
                                            Margin="0,0,0,4"/>
                                        <ComboBox x:Name="cmbAndroidCodec"
                                            Height="32"
                                            Style="{StaticResource DarkComboBox}">
                                            <ComboBoxItem Content="H264"/>
                                            <ComboBoxItem Content="HEVC"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <Button x:Name="btnScanAndroidDevices"
                                        Height="34"
                                        Margin="0,12,0,0"
                                        Content="Detectar teléfono Android"
                                        Click="btnScanAndroidDevices_Click"
                                        Style="{StaticResource BtnPrimary}"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Status -->
                    <Border Grid.Row="2"
                            Background="#080A10"
                            BorderBrush="#1E2235" BorderThickness="0,1,0,0"
                            Padding="14">
                        <TextBlock x:Name="lblConfigStatus"
                                   Text="Configuración lista"
                                   FontFamily="Segoe UI" FontSize="10"
                                   Foreground="#3D4260"/>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
