<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        x:Class="PixelVR.MainWindow"
        Title="PixelVR Connect" Height="780" Width="1300"
        MinWidth="1050" MinHeight="620"
        Background="#0A0C12"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="DarkComboBox" TargetType="ComboBox"
               BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Foreground" Value="#C8CEDD"/>
            <Setter Property="Background" Value="#12151F"/>
            <Setter Property="BorderBrush" Value="#2A2E42"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="materialDesign:ComboBoxAssist.ShowSelectedItem" Value="True"/>
            <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="#7C6AF7"/>
            <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="7"/>
            <Setter Property="materialDesign:ColorZoneAssist.Background" Value="#12151F"/>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button"
               BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#22C993"/>
            <Setter Property="Background" Value="#1A22C993"/>
            <Setter Property="BorderBrush" Value="#3322C993"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="7"/>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button"
               BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F05252"/>
            <Setter Property="Background" Value="#1AF05252"/>
            <Setter Property="BorderBrush" Value="#2AF05252"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="7"/>
        </Style>

        <Style x:Key="BtnNeutral" TargetType="Button"
               BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#9EA3B8"/>
            <Setter Property="Background" Value="#181B28"/>
            <Setter Property="BorderBrush" Value="#2A2E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="7"/>
        </Style>

        <Style x:Key="AxisLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="#7C6AF7"/>
        </Style>

        <Style x:Key="AxisValue" TargetType="Label">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#3D4260"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="VerticalNavTabItem" TargetType="TabItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#5C6280"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Width="84" Height="88" Background="{TemplateBinding Background}">
                            <Rectangle x:Name="AccentBar"
                                       Width="3" Fill="#7C6AF7"
                                       HorizontalAlignment="Left"
                                       Visibility="Collapsed"/>
                            <Rectangle Height="1" Fill="#1E2235"
                                       VerticalAlignment="Bottom"
                                       Margin="10,0"/>
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#0D0F1C"/>
                                <Setter TargetName="AccentBar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="#0D0F1A"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainNavTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="#0A0C12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="TabStripPlacement" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="84"
                                    Background="#0A0C10"
                                    BorderBrush="#1E2235"
                                    BorderThickness="0,0,1,0">
                                <TabPanel x:Name="HeaderPanel"
                                          IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1"
                                          Panel.ZIndex="1"
                                          Background="Transparent"/>
                            </Border>
                            <Border Grid.Column="1" Background="{TemplateBinding Background}">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True" Background="#0A0C12">

        <Border DockPanel.Dock="Top"
                Height="50"
                Background="#0E1120"
                BorderBrush="#1E2235"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="26" Height="26" CornerRadius="6"
                            Background="#201C5F" Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <Grid>
                            <Ellipse Width="10" Height="10" Fill="#7C6AF7"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="4" Height="4" Fill="#E8EAF6"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock
                               FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"
                               Foreground="#E8EAF6" VerticalAlignment="Center"><Run Language="es-ar" Text="Pixel"/><Run Text="VR"/></TextBlock>
                    <TextBlock Text=" Connect"
                               FontFamily="Segoe UI" FontSize="14" FontWeight="Light"
                               Foreground="#7C6AF7" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="Simulador de posición para controles VR"
                           FontFamily="Segoe UI" FontSize="11"
                           Foreground="#3D4260"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,14,0">
                    <Border Background="#141728" BorderBrush="#1E2235" BorderThickness="1"
                            CornerRadius="4" Padding="8,3" Margin="0,0,10,0" Height="20">
                        <TextBlock Text="v0.1.0-alpha"
                                   FontFamily="Consolas" FontSize="10"
                                   Foreground="#3D4260"/>
                    </Border>
                    <Menu Background="Transparent" Foreground="#5C6280" VerticalAlignment="Center">
                        <MenuItem Header="Ayuda" FontFamily="Segoe UI" FontSize="12" Foreground="#5C6280">
                            <MenuItem Header="Acerca de..." Foreground="#C8CEDD"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Height="26"
                Background="#080A10"
                BorderBrush="#1E2235"
                BorderThickness="0,1,0,0"
                Padding="14,0">
            <TextBlock x:Name="txtStatusBar"
                       Text="0 cámara(s) detectada(s)"
                       FontFamily="Segoe UI" FontSize="10"
                       Foreground="#3D4260"
                       VerticalAlignment="Center"/>
        </Border>

        <TabControl x:Name="mainTabs"
                    Style="{StaticResource MainNavTabControl}"
                    SelectedIndex="0" 
                    >

            <!-- PESTAÑA MAIN -->
            <TabItem x:Name="tabMain" Style="{StaticResource VerticalNavTabItem}">
                <TabItem.Header>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="HomeOutline"
                                                Width="28" Height="28"
                                                Foreground="#7C6AF7"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,6"/>
                        <TextBlock Text="Main"
                                   FontFamily="Segoe UI" FontSize="10"
                                   Foreground="#9EA3B8"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid x:Name="contentMain" Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Panel izquierdo: conexión y serial -->
                    <Border Grid.Column="0"
                            Background="#0E1120"
                            BorderBrush="#1E2235"
                            BorderThickness="1"
                            CornerRadius="10"
                            Margin="0,0,10,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                            <StackPanel Margin="16">

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Rectangle Height="1" Fill="#2A2E42" Width="16"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="USB-CDC"
                                               FontFamily="Consolas" FontSize="9" FontWeight="Bold"
                                               Foreground="#7C6AF7" VerticalAlignment="Center"/>
                                    <Rectangle Height="1" Fill="#2A2E42" Width="16"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>

                                <TextBlock Text="Puerto COM / Serial"
                                           FontFamily="Segoe UI" FontSize="11"
                                           Foreground="#9EA3B8" Margin="0,0,0,6"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox x:Name="usbcdcComboBox"
                                              Grid.Column="0"
                                              Height="34"
                                              IsEditable="True"
                                              IsTextSearchEnabled="False"
                                              Style="{StaticResource DarkComboBox}"
                                              SelectionChanged="usbcdcComboBox_SelectionChanged"
                                              TextBoxBase.TextChanged="usbcdcComboBox_TextChanged"/>

                                    <Button x:Name="btnRefreshUSBCDCPorts"
                                            Grid.Column="1"
                                            Content="↻"
                                            Width="34" Height="34"
                                            Margin="6,0,0,0"
                                            FontSize="14" Foreground="#9EA3B8"
                                            Background="#12151F" BorderBrush="#2A2E42" BorderThickness="1"
                                            materialDesign:ButtonAssist.CornerRadius="6"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Padding="0"
                                            Click="btnRefreshUSBCDCPorts_Click"/>
                                </Grid>

                                <TextBlock Text="Ejemplo: COM3, COM12 o /dev/ttyUSB0"
                                           FontFamily="Segoe UI" FontSize="10"
                                           Foreground="#3D4260" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="btnStartUSBCDC"
                                            Grid.Column="0"
                                            Height="34"
                                            FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                            Background="#1522C993" Foreground="#22C993"
                                            BorderBrush="#3022C993" BorderThickness="1"
                                            materialDesign:ButtonAssist.CornerRadius="7"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Margin="0,0,4,0"
                                            Click="btnStartUSBCDC_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Play" Width="13" Height="13"
                                                                    VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="INICIAR" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="btnStopUSBCDC"
                                            Grid.Column="1"
                                            Height="34"
                                            FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                            Background="#15F05252" Foreground="#F05252"
                                            BorderBrush="#2AF05252" BorderThickness="1"
                                            materialDesign:ButtonAssist.CornerRadius="7"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Margin="4,0,0,0"
                                            Click="btnStopUSBCDC_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Stop" Width="13" Height="13"
                                                                    VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="DETENER" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Rectangle Height="1" Fill="#2A2E42" Width="16"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="ESTADO"
                                               FontFamily="Consolas" FontSize="9" FontWeight="Bold"
                                               Foreground="#7C6AF7" VerticalAlignment="Center"/>
                                    <Rectangle Height="1" Fill="#2A2E42" Width="16"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>

                                <Border Background="#12151F" BorderBrush="#1E2235" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Conexión USB-CDC"
                                                   FontFamily="Segoe UI" FontSize="10"
                                                   Foreground="#3D4260" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="usbcdcStatusText" Text="Desconectado"
                                                   FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#DE2E2E"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Panel derecho: rack de dispositivos -->
                    <Border Grid.Column="1"
                            Background="#0E1120"
                            BorderBrush="#1E2235" BorderThickness="1"
                            CornerRadius="10">
                        <DockPanel LastChildFill="True">

                            <Border DockPanel.Dock="Top"
                                    Background="#0A0D18"
                                    BorderBrush="#1E2235" BorderThickness="0,0,0,1"
                                    CornerRadius="10,10,0,0"
                                    Padding="14,8">
                                <TextBlock Text="DISPOSITIVOS"
                                           FontFamily="Consolas" FontSize="9" FontWeight="Bold"
                                           Foreground="#3D4260"/>
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                                <StackPanel Margin="0,0,0,0">

                                    <!-- Left Controller -->
                                    <Border Margin="10,12,10,0"
                                            Background="#12151F"
                                            BorderBrush="#252942" BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="12,12">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Width="28" Height="28" CornerRadius="7"
                                                        Background="#1C1850" Margin="0,0,9,0">
                                                    <Image Source="/handheld_controller_100dp_5137FF_FILL0_wght400_GRAD0_opsz48.png" Margin="5,2,5,2"/>
                                                </Border>

                                                <TextBlock Grid.Column="1"
                                                           Text="Left Controller"
                                                           FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="#C8CEDD" VerticalAlignment="Center"/>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse x:Name="leftcontrollCircle"
                                                             Width="6" Height="6" Fill="#FFF05252"
                                                             VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <Label x:Name="leftController_connection"
                                                           Content="Offline"
                                                           FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="#FFF05252" Padding="0"/>
                                                </StackPanel>
                                            </Grid>

                                            <Rectangle Height="1" Fill="#1E2235" Margin="0,0,0,9"/>

                                            <TextBlock Text="POSICIÓN"
                                                       FontFamily="Consolas" FontSize="8" FontWeight="Bold"
                                                       Foreground="#3D4260" Margin="0,0,0,5"/>
                                            <Grid Margin="0,0,0,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <Border Background="#0A0C18" CornerRadius="3" Padding="4,2" Margin="0,0,4,0">
                                                        <TextBlock Text="X" Style="{StaticResource AxisLabel}" Foreground="#FF5137FF"/>
                                                    </Border>
                                                    <Label x:Name="leftPositionX" Content="—" Style="{StaticResource AxisValue}" FontSize="12"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Border Background="#0A0C18" CornerRadius="3" Padding="4,2" Margin="0,0,4,0">
                                                        <TextBlock Text="Y" Style="{StaticResource AxisLabel}" Foreground="#FF5137FF"/>
                                                    </Border>
                                                    <Label x:Name="leftPositionY" Content="—" Style="{StaticResource AxisValue}" FontSize="12"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <Border Background="#0A0C18" CornerRadius="3" Padding="4,2" Margin="0,0,4,0">
                                                        <TextBlock Text="Z" Style="{StaticResource AxisLabel}" Foreground="#FF5137FF"/>
                                                    </Border>
                                                    <Label x:Name="leftPositionZ" Content="—" Style="{StaticResource AxisValue}" FontSize="12"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="ROTACIÓN"
                                                       FontFamily="Consolas" FontSize="8" FontWeight="Bold"
                                                       Foreground="#3D4260" Margin="0,0,0,5"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <Border Background="#0A0C18" CornerRadius="3" Padding="4,2" Margin="0,0,4,0">
                                                        <TextBlock Text="P" Style="{StaticResource AxisLabel}" Foreground="#5C6280"/>
                                                    </Border>
                                                    <Label x:Name="leftRotationPitch" Content="—" Style="{StaticResource AxisValue}" FontSize="12"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Border Background="#0A0C18" CornerRadius="3" Padding="4,2" Margin="0,0,4,0">
                                                        <TextBlock Text="Y" Style="{StaticResource AxisLabel}" Foreground="#5C6280"/>
                                                    </Border>
                                                    <Label x:Name="leftRotationYaw" Content="—" Style="{StaticResource AxisValue}" FontSize="12"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <Border Background="#0A0C18" CornerRadius="3" Padding="4,2" Margin="0,0,4,0">
                                                        <TextBlock Text="R" Style="{StaticResource AxisLabel}" Foreground="#5C6280"/>
                                                    </Border>
                                                    <Label x:Name="leftRotationRoll" Content="—" Style="{StaticResource AxisValue}" FontSize="12"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Rectangle Height="1" Fill="#1A1E2E" Margin="10,10,10,0"/>

                                    <!-- VR Headset -->
                                    <Border Margin="10,10,10,0"
                                            Background="#12151F"
                                            BorderBrush="#252942" BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="12,12">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Width="28" Height="28" CornerRadius="7"
                                                        Background="#251820" Margin="0,0,9,0">
                                                    <Image Source="/head_mounted_device_100dp_F05252_FILL0_wght400_GRAD0_opsz48.png" Margin="3,5,3,5"/>
                                                </Border>

                                                <TextBlock Grid.Column="1"
                                                           Text="VR Headset"
                                                           FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="#C8CEDD" VerticalAlignment="Center"/>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse x:Name="VRHeadsetCircle"
                                                             Width="6" Height="6" Fill="#F05252"
                                                             VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <Label x:Name="VRHeadset_connection"
                                                           Content="Offline"
                                                           FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="#F05252" Padding="0"/>
                                                </StackPanel>
                                            </Grid>

                                            <Rectangle Height="1" Fill="#1E2235" Margin="0,0,0,9"/>

                                            <TextBlock Text="POSICIÓN"
                                                       FontFamily="Consolas" FontSize="8" FontWeight="Bold"
                                                       Foreground="#3D4260" Margin="0,0,0,5"/>
                                            <Grid Margin="0,0,0,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <Border Background="#0A0C18" CornerRadius="3" Padding="4,2" Margin="0,0,4,0">
                                                        <TextBlock Text="X" Style="{StaticResource AxisLabel}" Foreground="#F05252"/>
                                                    </Border>
                                                    <Label x:Name="VRPositionX" Content="—" Style="{StaticResource AxisValue}" FontSize="12"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Border Background="#0A0C18" CornerRadius="3" Padding="4,2" Margin="0,0,4,0">
                                                        <TextBlock Text="Y" Style="{StaticResource AxisLabel}" Foreground="#F05252"/>
                                                    </Border>
                                                    <Label x:Name="VRPositionY" Content="—" Style="{StaticResource AxisValue}" FontSize="12"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <Border Background="#0A0C18" CornerRadius="3" Padding="4,2" Margin="0,0,4,0">
                                                        <TextBlock Text="Z" Style="{StaticResource AxisLabel}" Foreground="#F05252"/>
                                                    </Border>
                                                    <Label x:Name="VRPositionZ" Content="—" Style="{StaticResource AxisValue}" FontSize="12"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="ROTACIÓN"
                                                       FontFamily="Consolas" FontSize="8" FontWeight="Bold"
                                                       Foreground="#3D4260" Margin="0,0,0,5"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <Border Background="#0A0C18" CornerRadius="3" Padding="4,2" Margin="0,0,4,0">
                                                        <TextBlock Text="P" Style="{StaticResource AxisLabel}" Foreground="#5C6280"/>
                                                    </Border>
                                                    <Label x:Name="VRRotationPitch" Content="—" Style="{StaticResource AxisValue}" FontSize="12"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Border Background="#0A0C18" CornerRadius="3" Padding="4,2" Margin="0,0,4,0">
                                                        <TextBlock Text="Y" Style="{StaticResource AxisLabel}" Foreground="#5C6280"/>
                                                    </Border>
                                                    <Label x:Name="VRRotationYaw" Content="—" Style="{StaticResource AxisValue}" FontSize="12"/>
                                                </StackPanel>
